# Copy to .env and fill in. NEVER commit .env.
# Used only by the local Vite dev proxy (server side); the key is never sent to the browser bundle.
ANTHROPIC_API_KEY=
# The model name IS sent in the request body built client-side (src/ai/liveClient.js), so it
# needs the VITE_ prefix to be exposed to browser code at all — unlike ANTHROPIC_API_KEY above.
VITE_ANTHROPIC_MODEL=claude-sonnet-5
# "live" = call the API through the dev proxy; "demo" = replay recorded responses from data/demo/
VITE_AI_MODE=demo
